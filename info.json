{
  "id": "plugin.com.pot-app.openai",
  "plugin_type": "translate",
  "icon": "lingva.svg",
  "display": "OpenAI",
  "homepage": "https://github.com/WonderMr/pot-app-translate-openai",
  "needs": [
    {
      "key": "apiKey",
      "display": "API Key",
      "type": "input",
      "password": true
    },
    {
      "key": "model",
      "display": "Model",
      "type": "select",
      "options": {
        "gpt-4o": "GPT-4o",
        "gpt-4o-mini": "GPT-4o Mini",
        "gpt-4-turbo": "GPT-4 Turbo",
        "gpt-3.5-turbo": "GPT-3.5 Turbo"
      }
    },
    {
      "key": "apiEndpoint",
